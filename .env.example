# WeBe contract - DO NOT RENAME VARIABLES
WEBE_API_BASE_URL=https://webefriends.com
WEBE_PAGE_ID=<webe-page-uid>
WEBE_SITE_SLUG=howlin-yuma
WEBE_API_KEY=<secret>
WEBE_CHECKOUT_SUCCESS_URL=https://example.com/checkout/success
WEBE_CHECKOUT_CANCEL_URL=https://example.com/checkout/cancel
# WEBE_WEBHOOK_URL=https://example.com/api/webe/webhook
# WEBE_WEBHOOK_SECRET=<secret>
WEBE_SERVICE_FEE_FLAT_CENTS=0
WEBE_SERVICE_FEE_PERCENT_BPS=0

# Public client-side configuration
PUBLIC_GOOGLE_MAPS_KEY=<google-maps-browser-key>
PUBLIC_GOOGLE_MAPS_QUERY=32.661764,-114.366694
PUBLIC_GOOGLE_MAPS_ZOOM=16
PUBLIC_GOOGLE_MAPS_MAP_ID=<google-map-id>
PUBLIC_GOOGLE_MAPS_USE_MAP_ID=true
PUBLIC_GA_MEASUREMENT_ID=<ga-measurement-id>
PUBLIC_SITE_URL=https://example.com
PUBLIC_FESTIVAL_TIMEZONE=America/Phoenix
